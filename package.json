{
  "name": "elysia-youtube-downloader",
  "version": "1.0.0",
  "description": "A simple YouTube video/audio downloader API using Elysia and youtubei.js",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "start": "concurrently \"bun run index.ts\" \"bun next start\"",
    "dev": "concurrently \"bun --hot index.ts\" \"bun next dev\"",
    "build": "next build"
  },
  "dependencies": {
    "@elysiajs/static": "latest",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.22",
    "axios": "latest",
    "cheerio": "latest",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "elysia": "latest",
    "entities": "latest",
    "ffmpeg-static": "latest",
    "framer-motion": "^12.23.26",
    "json-custom-numbers": "latest",
    "lucide-react": "^0.560.0",
    "memoirist": "latest",
    "moment-timezone": "0.6.0",
    "next": "^16.0.8",
    "node-fetch": "latest",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "youtubei.js": "latest"
  },
  "devDependencies": {
    "bun-types": "latest",
    "typescript": "^5.4.5",
    "@types/node-fetch": "latest"
  },
  "keywords": [
    "youtube",
    "download",
    "api",
    "elysia",
    "bun"
  ],
  "author": "Shikaki || Priyanshi Kaur",
  "license": "MIT"
}
