{
  "name": "elysia-youtube-downloader",
  "version": "1.0.0",
  "description": "A simple YouTube video/audio downloader API using Elysia and youtubei.js",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "start": "concurrently \"bun run index.ts\" \"bun next start\"",
    "dev": "concurrently \"bun --hot index.ts\" \"bun next dev\"",
    "build": "next build"
  },
  "dependencies": {
    "@elysiajs/static": "latest",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "autoprefixer": "10.4.19",
    "axios": "latest",
    "cheerio": "latest",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "elysia": "latest",
    "entities": "latest",
    "ffmpeg-static": "latest",
    "framer-motion": "^12.23.26",
    "json-custom-numbers": "latest",
    "lucide-react": "^0.560.0",
    "memoirist": "latest",
    "next": "15.1.0",
    "node-fetch": "latest",
    "postcss": "8.4.31",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "3.4.1",
    "youtubei.js": "latest"
  },
  "devDependencies": {
    "bun-types": "latest",
    "typescript": "^5.4.5",
    "@types/node-fetch": "latest"
  },
  "keywords": [
    "youtube",
    "download",
    "api",
    "elysia",
    "bun"
  ],
  "author": "Shikaki || Priyanshi Kaur",
  "license": "MIT"
}
