    "@elysiajs/static": "latest",
    "node-fetch": "latest",
    "@types/node-fetch": "latest",
    "https-proxy-agent": "latest",
    "socks-proxy-agent": "latest",
    "cheerio": "latest",
    "@tensorflow/tfjs-node": "latest"
